{
  "manifest_version": 3,
  "name": "ModSearch",
  "version": "0.0.1",
  "description": "Local-first universal fashion search. Personalizes on your device; your data stays local.",
  "permissions": ["storage", "alarms", "nativeMessaging", "sidePanel", "tabs"],
  "host_permissions": ["https://nomanwalksalone.com/*", "https://www.nomanwalksalone.com/*"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://nomanwalksalone.com/*", "https://www.nomanwalksalone.com/*"],
      "js": ["src/content/capture-core.js", "src/consent/consent.js", "src/content/dwell.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open ModSearch" },
  "side_panel": { "default_path": "app/index.html" },
  "web_accessible_resources": [
    { "resources": ["app/*"], "matches": ["<all_urls>"] }
  ]
}
