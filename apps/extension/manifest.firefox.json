{
  "manifest_version": 3,
  "name": "AuraSearch",
  "version": "0.0.1",
  "description": "Local-first universal fashion search. Personalizes on your device; your data stays local.",
  "permissions": ["storage", "alarms", "nativeMessaging"],
  "host_permissions": [],
  "background": { "scripts": ["background/service-worker.js"], "type": "module" },
  "browser_specific_settings": { "gecko": { "id": "aurasearch@aurasearch.dev" } },
  "action": { "default_title": "AuraSearch" }
}
